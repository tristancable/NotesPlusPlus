@page "/note/{folderName}/{fileName}"
@using Notes__.Utilities
@inject FolderService FolderService
@inject LayoutService LayoutService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="input-container">
    <input @bind="newNote" @oninput="OnSearchInput" @onkeydown="HandleKeyPress" placeholder="Search or write a note..." />

    <select @onchange="ChangeCategory">
        <option value="new">None</option>
        <option value="cat1">Cat1</option>
    </select>
    <button @onclick="() => NewCategory()">New Category</button>
</div>
<div>
    <button @onclick="() => ToggleBold()"><strong>B</strong></button>
    <button @onclick="() => ToggleItalic()"><i>I</i></button>
</div>

<ul>
    @foreach (var subcategory in filteredNotes)
    {
        <!-- Display subcategory name -->
        <li class="subcategory">
            <strong>@subcategory.Name</strong>
        </li>

        @foreach (var note in subcategory.Notes)
        {
            var index = subcategory.Notes.IndexOf(note);
            var formattedContent = note.Content;

            <li class="note">
                <span class="note-text">
                    @if (bold && italic)
                    {
                        <strong><i>@formattedContent</i></strong>
                    }
                    else if (bold)
                    {
                        <strong>@formattedContent</strong>
                    }
                    else if (italic)
                    {
                        <i>@formattedContent</i>
                    }
                    else
                    {
                        @formattedContent
                    }
                </span>
                <div class="buttons">
                    <button class="bi bi-arrow-up" @onclick="() => MoveNoteUp(subcategory, index)" disabled="@(index == 0)"></button>
                    <button class="bi bi-arrow-down" @onclick="() => MoveNoteDown(subcategory, index)" disabled="@(index == subcategory.Notes.Count - 1)"></button>
                    <button class="edit-button" @onclick="() => EditNote(note)">Edit</button>
                    <button class="delete-button" @onclick="() => DeleteNote(note.Id)">Delete</button>
                </div>
            </li>
        }
    }
</ul>


@code {
    [Parameter] public string folderName { get; set; }
    [Parameter] public string fileName { get; set; }

    private List<Subcategory> notes = new() { new Subcategory("") };
    private List<Subcategory> filteredNotes = new() { new Subcategory("") };
    private string newNote = "";
    private bool bold = false;
    private bool italic = false;
    private string currentNoteToEdit = null;
    private Subcategory currentCategory = null;
    private string addOrEditButtonText = "Add Note";

    protected override void OnParametersSet()
    {
        LayoutService.PageTitle = $"/{folderName}/{fileName}";
    }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(folderName) && !string.IsNullOrWhiteSpace(fileName))
        {
            if (fileName.EndsWith(" - B")) LayoutService.Format = LayoutService.EFormat.BULLETPOINT;
            else if (fileName.EndsWith(" - N")) LayoutService.Format = LayoutService.EFormat.NUMBERED;
            else LayoutService.Format = LayoutService.EFormat.BASIC;
            LoadFile(); // Load the file content
        }
    }

    void OnSearchInput(ChangeEventArgs e)
    {
        newNote = e.Value.ToString();
        FilterNotes();
    }

    void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddNoteOrEditNote();
    }

    void AddNoteOrEditNote()
    {
        if (!string.IsNullOrWhiteSpace(newNote))
        {
            if (!string.IsNullOrEmpty(currentNoteToEdit))
            {
                foreach (Subcategory subcategory in notes)
                {
                    // Edit existing note by Id
                    var noteToEdit = subcategory.Notes.FirstOrDefault(n => n.Id.ToString() == currentNoteToEdit);
                    if (noteToEdit != null)
                    {
                        switch (LayoutService.Format) // Update the content of the note
                        {
                            case LayoutService.EFormat.BULLETPOINT:
                                noteToEdit.Content = $"• {newNote}";
                                break;
                            case LayoutService.EFormat.NUMBERED:
                                noteToEdit.Content = $"{LayoutService.EditNumber}. {newNote}";
                                break;
                            default:
                                noteToEdit.Content = newNote;
                                break;
                        }
                        currentNoteToEdit = null;  // Reset edit context
                        addOrEditButtonText = "Add Note";  // Reset button text
                    }
                }
            }
            else
            {
                switch (LayoutService.Format) // Add new note
                {
                    case LayoutService.EFormat.BULLETPOINT:
                        currentCategory.Notes.Add(new Note($"• {newNote}"));
                        break;
                    case LayoutService.EFormat.NUMBERED:
                        currentCategory.Notes.Add(new Note($"{notes.Count() + 1}. {newNote}"));
                        break;
                    default:
                        currentCategory.Notes.Add(new Note(newNote)); // Add a new note with a unique ID
                        break;
                }
            }

            newNote = "";
            SaveFile();
            FilterNotes();
        }
    }

    void LoadFile()
    {
        try
        {
            if (!fileName.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
            {
                fileName += ".txt";
            }

            var content = FolderService.ReadFileContent(folderName, fileName);
            if (string.IsNullOrWhiteSpace(content))
            {
                Console.WriteLine("File content is empty or null.");
            }
            else
            {
                Console.WriteLine($"File content loaded: {content.Length} characters.");
            }

            Subcategory currentSubcategory = notes[0];
            foreach(string line in content.Split("\n").ToList())
            {
                if (string.IsNullOrWhiteSpace(line))
                {
                    currentSubcategory = null;
                    continue;
                }
                if (currentSubcategory == null)
                {
                    currentSubcategory = new Subcategory(line);
                    notes.Add(currentSubcategory);
                }
                else currentSubcategory.Notes.Add(new Note(line));
            }
            FilterNotes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading file: {ex.Message}");
        }
    }

    void SaveFile()
    {
        try
        {
            var lines = new List<string>();

            foreach (var subcategory in notes)
            {
                if (!string.IsNullOrWhiteSpace(subcategory.Name)) lines.Add(""); // Empty line before subcategory name except the default
                lines.Add(subcategory.Name); // Subcategory name
                lines.AddRange(subcategory.Notes.Select(n => n.Content)); // Notes under subcategory
            }

            FolderService.SaveFileContent(folderName, fileName, string.Join("\n", lines));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving file: {ex.Message}");
        }
    }


    void FilterNotes()
    {
        try
        {
            filteredNotes = string.IsNullOrEmpty(newNote) ? notes : notes.Where(s => s.Notes.Any(n => n.Content.Contains(newNote, StringComparison.OrdinalIgnoreCase))).Select(s => new Subcategory(s.Name)
            {
                Notes = s.Notes.Where(n => n.Content.Contains(newNote, StringComparison.OrdinalIgnoreCase)).ToList()
            }).ToList();
            Console.WriteLine($"Filtered notes count: {filteredNotes.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering notes: {ex.Message}");
        }
    }

    void EditNote(Note note)
    {
        // Set the currentNoteToEdit to the Id of the note being edited
        currentNoteToEdit = note.Id.ToString();
        switch (LayoutService.Format)
        {
            case LayoutService.EFormat.BULLETPOINT:
                newNote = note.Content.Substring(2);
                break;
            case LayoutService.EFormat.NUMBERED:
                int editNumber;
                int.TryParse(note.Content.Substring(0, 1), out editNumber);
                LayoutService.EditNumber = editNumber;
                newNote = note.Content.Substring(2);
                break;
            default:
                newNote = note.Content;
                break;
        }
        addOrEditButtonText = "Save Changes"; // Change button text to "Save Changes"
    }

    void DeleteNote(Guid noteId)
    {
        foreach (Subcategory subcategory in notes)
        {
            Note noteToDelete = subcategory.Notes.FirstOrDefault(n => n.Id == noteId);
            if (noteToDelete != null)
            {
                subcategory.Notes.Remove(noteToDelete);
                ReorderNumbers();
                SaveFile();
                return; // Exit after deleting to avoid unnecessary iterations
            }
        }
    }

    void MoveNoteUp(Subcategory subcategory, int index)
    {
        if (index > 0)
        {
            var temp = subcategory.Notes[index];
            subcategory.Notes[index] = subcategory.Notes[index - 1];
            subcategory.Notes[index - 1] = temp;
            ReorderNumbers();
            SaveFile();
            FilterNotes();
        }
    }

    void MoveNoteDown(Subcategory subcategory, int index)
    {
        if (index < subcategory.Notes.Count - 1)
        {
            var temp = subcategory.Notes[index];
            subcategory.Notes[index] = subcategory.Notes[index + 1];
            subcategory.Notes[index + 1] = temp;
            ReorderNumbers();
            SaveFile();
            FilterNotes();
        }
    }

    void ReorderNumbers()
    {
        if (LayoutService.Format == LayoutService.EFormat.NUMBERED)
        {
            foreach (var subcategory in filteredNotes)
            {
                for (int i = 0; i < subcategory.Notes.Count; i++)
                {
                    // Remove old numbering (assuming format is "X. Content")
                    string contentWithoutNumber = subcategory.Notes[i].Content.Contains(". ")
                        ? subcategory.Notes[i].Content.Substring(subcategory.Notes[i].Content.IndexOf(". ") + 2)
                        : subcategory.Notes[i].Content;

                    // Apply new numbering within the subcategory
                    subcategory.Notes[i].Content = $"{i + 1}. {contentWithoutNumber}";
                }
            }
        }
    }


    void ToggleBold()
    {
        if (bold)
        {
            bold = false;
        }
        else 
        {
            bold = true;
        }
    }

    void ToggleItalic()
    {
        if (italic)
        {
            italic = false;
        }
        else
        {
            italic = true;
        }
    }

    private async Task ChangeCategory(ChangeEventArgs e)
    {
        //var category = e.Value.ToString();

    }

    void NewCategory() 
    { //very very basic and lacking
        Subcategory newCategory = new Subcategory(newNote);
        currentCategory = newCategory;
        newNote = "";
    }
}
